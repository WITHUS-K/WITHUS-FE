{
  "extends": "@repo/typescript-config/react-library.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "src",
    "outDir": "./dist",
    "declaration": true,
    "types": ["@vanilla-extract/css"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
