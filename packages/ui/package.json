{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./icons/colored": "./src/icons/src/colored/index.ts",
    "./icons/mono": "./src/icons/src/mono/index.ts",
    "./styles": "./dist/index.css",
    "./hooks": {
      "import": "./dist/hooks/index.js",
      "types": "./dist/hooks/index.d.ts"
    },
    "./Button": {
      "types": "./dist/components/Button/index.d.ts",
      "import": "./dist/components/Button/index.js"
    },
    "./CheckBox": {
      "types": "./dist/components/CheckBox/index.d.ts",
      "import": "./dist/components/CheckBox/index.js"
    },
    "./DropDown": {
      "types": "./dist/components/DropDown/index.d.ts",
      "import": "./dist/components/DropDown/index.js"
    },
    "./Flex": {
      "types": "./dist/components/Flex/index.d.ts",
      "import": "./dist/components/Flex/index.js"
    },
    "./InputField": {
      "types": "./dist/components/Input/index.d.ts",
      "import": "./dist/components/Input/index.js"
    },
    "./TextField": {
      "types": "./dist/components/Input/index.d.ts",
      "import": "./dist/components/Input/index.js"
    },
    "./Modal": {
      "types": "./dist/components/Modal/index.d.ts",
      "import": "./dist/components/Modal/index.js"
    },
    "./Text": {
      "types": "./dist/components/Text/index.d.ts",
      "import": "./dist/components/Text/index.js"
    },
    "./Chips": {
      "types": "./dist/components/Chips/index.d.ts",
      "import": "./dist/components/Chips/index.js"
    },
    "./Header": {
      "types": "./dist/components/Header/index.d.ts",
      "import": "./dist/components/Header/index.js"
    },
    "./List": {
      "types": "./dist/components/List/index.d.ts",
      "import": "./dist/components/List/index.js"
    },
    "./Pagination": {
      "types": "./dist/components/Pagination/index.d.ts",
      "import": "./dist/components/Pagination/index.js"
    },
    "./Profile": {
      "types": "./dist/components/Profile/index.d.ts",
      "import": "./dist/components/Profile/index.js"
    },
    "./Sidebar": {
      "types": "./dist/components/Sidebar/index.d.ts",
      "import": "./dist/components/Sidebar/index.js"
    },
    "./Stepper": {
      "types": "./dist/components/Stepper/index.d.ts",
      "import": "./dist/components/Stepper/index.js"
    }
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && node esbuild.config.mjs",
    "dev": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.mjs --watch",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "svgr:mono": "svgr --out-dir src/icons/src/mono src/icons/assets/mono --typescript --icon --jsx-runtime automatic",
    "svgr:colored": "svgr --out-dir src/icons/src/colored src/icons/assets/colored",
    "svg:build": "pnpm svgr:mono && pnpm svgr:colored"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^3",
    "@repo/eslint-config": "workspace:*",
    "@repo/theme": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@repo/utils": "workspace:*",
    "@storybook/addon-actions": "^8.6.12",
    "@storybook/addon-essentials": "^8.6.12",
    "@storybook/addon-onboarding": "^8.6.12",
    "@storybook/blocks": "^8.6.12",
    "@storybook/experimental-addon-test": "^8.6.12",
    "@storybook/react": "^8.6.12",
    "@storybook/react-vite": "^8.6.12",
    "@storybook/test": "^8.6.12",
    "@svgr/cli": "^8.1.0",
    "@turbo/gen": "^2.5.0",
    "@types/node": "^22.14.0",
    "@types/react": "19.1.0",
    "@types/react-dom": "19.1.1",
    "@vanilla-extract/esbuild-plugin": "^2.3.15",
    "@vanilla-extract/vite-plugin": "^5.0.1",
    "@vitest/browser": "^3.1.1",
    "@vitest/coverage-v8": "^3.1.1",
    "chromatic": "^11.28.0",
    "esbuild": "^0.25.2",
    "esbuild-plugin-alias": "^0.2.1",
    "esbuild-plugin-copy": "^2.1.1",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "esbuild-plugin-svgr": "^3.1.1",
    "eslint": "^9.24.0",
    "eslint-plugin-storybook": "^0.12.0",
    "overlay-kit": "^1.7.0",
    "playwright": "^1.51.1",
    "storybook": "^8.6.12",
    "svgo": "^3.3.2",
    "typescript": "5.8.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "@repo/theme": "workspace:^",
    "@repo/utils": "workspace:^",
    "@vanilla-extract/css": "^1.17.1",
    "@vanilla-extract/recipes": "^0.5.5",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
  }
}
