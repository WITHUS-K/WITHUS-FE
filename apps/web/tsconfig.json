{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@web/*": ["./src/*"],
      "@repo/ui/*": ["packages/ui/src/*"],
      "@repo/theme/*": ["packages/theme/src/*"]
    },
    "baseUrl": "./",
    "allowJs": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
